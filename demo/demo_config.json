{
    "train_dataset": "demo/data/train.tsv",
    "test_dataset": "demo/data/test.tsv",
    "output_path": "demo/output/",
    "pretrain": "hanyangii/methylbert_hg19_2l",
    "n_encoder": 2,
    "n_mers": 3,
    "seq_len": 250,
    "batch_size": 30,
    "loss": "focal",
    "focal_gamma": 0,
    "focal_weight": [1.0, 1.0, 1.0],
    "num_classes": 3,
    "use_balanced_batches": true,
    "use_balanced_test_eval": false,
    "max_grad_norm": 1.0,
    "gradient_accumulation_steps": 1,
    "steps": 60,
    "num_workers": 0,
    "with_cuda": false,
    "log_freq": 10,
    "eval_freq": 20,
    "lr": 5e-05,
    "adam_weight_decay": 0.01,
    "adam_beta1": 0.9,
    "adam_beta2": 0.98,
    "warm_up": 10,
    "decrease_steps": 50
}
